<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately not sandboxed: see DebugProfile.entitlements. The
	     companion's file and command tools need the user's real filesystem,
	     which the sandbox does not allow. The Mac App Store requires a
	     sandboxed build, so this app ships outside it. -->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
